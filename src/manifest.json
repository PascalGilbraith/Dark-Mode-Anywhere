{
  "manifest_version": 2,
  "name": "Dark Mode Anywhere",
  "version": "1.0.0",
  "description": "Adds dark mode to any web page.",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": ["storage", "activeTab"],
  "browser_action": {
    "default_title": "Dark Mode Anywhere",
    "default_icon": "icons/icon.svg",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "dark-mode-anywhere@bigbluealien.com",
      "strict_min_version": "91.0"
    }
  }
}
